{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memory extraction proposal v1",
  "description": "Untrusted model proposals. Host validation of scope, source spans, semantics, revisions and permissions is mandatory. No automatic execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "coverage", "entities", "claims", "unresolved"],
  "properties": {
    "version": {"const": 1},
    "coverage": {"type": "string", "enum": ["complete", "partial", "none"]},
    "entities": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["handle", "kind", "label", "source", "quote"],
        "properties": {
          "handle": {"type": "string", "pattern": "^n[0-7]$"},
          "kind": {"type": "string", "enum": ["person", "organization", "project", "goal", "commitment", "question", "place", "occupation", "topic"]},
          "label": {"type": "string", "minLength": 1, "maxLength": 128},
          "source": {"type": "string", "pattern": "^e[0-9]{1,3}$"},
          "quote": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "claims": {
      "type": "array", "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["action", "target", "subject", "predicate", "object", "polarity", "modality", "valid_from", "valid_to", "conditions", "evidence"],
        "properties": {
          "action": {"type": "string", "enum": ["add", "correct"]},
          "target": {"type": ["string", "null"], "pattern": "^c[0-9]{1,3}$"},
          "subject": {"type": "string", "pattern": "^(u|a|[xn][0-9]{1,3})$"},
          "predicate": {"type": "string", "enum": ["prefers", "interested_in", "works_on", "member_of", "has_goal", "blocked_by", "depends_on", "reason_for", "status", "due_at", "asks", "associated_with", "sibling_of", "parent_of", "partner_of", "has_occupation", "lives_in", "owns", "uses"]},
          "object": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "value"],
            "properties": {
              "kind": {"type": "string", "enum": ["reference", "text", "timestamp"]},
              "value": {"type": "string", "minLength": 1, "maxLength": 512}
            }
          },
          "polarity": {"type": "string", "enum": ["positive", "negative"]},
          "modality": {"type": "string", "enum": ["asserted", "reported", "hypothetical", "question", "fiction"]},
          "valid_from": {"type": ["string", "null"], "maxLength": 40},
          "valid_to": {"type": ["string", "null"], "maxLength": 40},
          "conditions": {"type": "array", "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
          "evidence": {
            "type": "array", "minItems": 1, "maxItems": 4,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["source", "quote"],
              "properties": {
                "source": {"type": "string", "pattern": "^e[0-9]{1,3}$"},
                "quote": {"type": "string", "minLength": 1, "maxLength": 512}
              }
            }
          }
        }
      }
    },
    "unresolved": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "reason"],
        "properties": {
          "source": {"type": "string", "pattern": "^e[0-9]{1,3}$"},
          "reason": {"type": "string", "enum": ["ambiguous_identity", "ambiguous_span", "conflict", "unknown_time", "unsupported_predicate", "budget", "insufficient_evidence"]}
        }
      }
    }
  }
}
