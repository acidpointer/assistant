+    llama_backend_init();ggml_backend_t backend=nullptr;int status=0;
+    try {
+        require(ggml_backend_vk_get_device_count()>0,"required Vulkan device unavailable");
+        backend=ggml_backend_vk_init(0);require(backend!=nullptr,"required Vulkan backend");
+        std::printf("PQ3 required backend: %s\n",ggml_backend_name(backend));
+        for(bool half:{false,true})for(bool wide:{false,true})writes(backend,half,wide);
+        attention(backend,1,7);attention(backend,8,65);attention(backend,64,512);
+        ggml_pq3_vulkan_observation observation{};
+        require(ggml_backend_vk_pq3_observe_v1(backend,&observation),"versioned GPU observation");
+
+        std::printf("PQ3 completed Vulkan writes=%llu attention=%llu path_mask=%u\n",(unsigned long long)observation.indexed_writes,(unsigned long long)observation.attention_operations,observation.path_mask);
+        require(observation.indexed_writes>0&&observation.attention_operations==3&&observation.path_mask!=0,"actual completed PQ3 submissions");
+        std::puts("PQ3 Vulkan graphs passed");
+    } catch(const std::exception & e) {std::fprintf(stderr,"PQ3 Vulkan test failed: %s\n",e.what());status=1;}
+    if(backend) { ggml_backend_free(backend); }
+    llama_backend_free();return status;
+}
