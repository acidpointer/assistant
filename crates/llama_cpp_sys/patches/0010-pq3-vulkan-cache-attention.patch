+float pq3_value(uint ib, uint iqs, uint a_offset) {
+    uint first=(iqs/8)*3;
+    uint bits=uint(data_a[a_offset+ib].qs[first]) | (uint(data_a[a_offset+ib].qs[first+1])<<8) | (uint(data_a[a_offset+ib].qs[first+2])<<16);
