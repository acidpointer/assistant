+layout(buffer_reference, std430, buffer_reference_align = 2) buffer decodeBufPQ3_0 { block_pq3_0 block; };
+float16_t dequantFuncPQ3_0(const in decodeBufPQ3_0 bl, const in uint bc[2], const in uint coord[2]) {
+    uint idx=coord[1], first=(idx/8)*3;
+    uint bits=uint(bl.block.qs[first]) | (uint(bl.block.qs[first+1])<<8) | (uint(bl.block.qs[first+2])<<16);
+    return float16_t(pq3_book[(bits>>(3*(idx%8)))&7]*float(bl.block.d));
+}
+f16vec4 dequantFuncPQ3_0_v(const in decodeBufPQ3_0 bl, const in uint bc[2], const in uint coord[2]) {
+    uint idx=coord[1], first=(idx/8)*3;
+    uint bits=uint(bl.block.qs[first]) | (uint(bl.block.qs[first+1])<<8) | (uint(bl.block.qs[first+2])<<16);
+    uint shift=3*(idx%8);
+    return f16vec4(vec4(pq3_book[(bits>>shift)&7],pq3_book[(bits>>(shift+3))&7],pq3_book[(bits>>(shift+6))&7],pq3_book[(bits>>(shift+9))&7])*float(bl.block.d));
+}
 
