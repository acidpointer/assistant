+            auto * src=ggml_new_tensor_2d(probe.get(),GGML_TYPE_F32,int64_t(128)*hp.n_head_kv(il),1);
+            auto * idx=ggml_new_tensor_1d(probe.get(),GGML_TYPE_I64,1);
