+}
+vec4 dequantize4(uint ib, uint iqs, uint a_offset) {
+    return vec4(pq3_value(ib,iqs,a_offset),pq3_value(ib,iqs+1,a_offset),pq3_value(ib,iqs+2,a_offset),pq3_value(ib,iqs+3,a_offset));
+}
+vec2 get_dm(uint ib, uint a_offset) { return vec2(float(data_a[a_offset+ib].d),0.0); }
 #endif
 
