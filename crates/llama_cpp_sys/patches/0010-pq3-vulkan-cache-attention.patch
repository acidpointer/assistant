+#if defined(DATA_A_PQ3_0)
+void quantize(uint dst_idx, uint src_idx) {
+    // Ordered sum matches the scalar oracle; precise forbids FMA reassociation.
+    precise float sum = 0.0;
+    for (uint j=0; j<128; ++j) { float x=float(data_s[src_idx+j]); sum += x*x; }
+    float norm=sqrt(sum);
+    float stored_norm=unpackHalf2x16(packHalf2x16(vec2(norm,0.0))).x;
+    data_q[dst_idx].d=float16_t(stored_norm);
+    if (stored_norm==0.0) {
+        for(uint j=0;j<48;++j) data_q[dst_idx].qs[j]=uint8_t(0);
+        return;
+    }
+    float inv=1.0/norm;
+    for(uint group=0;group<16;++group) {
+        uint bits=0;
+        for(uint lane=0;lane<8;++lane) {
+            float value=float(data_s[src_idx+8*group+lane])*inv;
+            uint index=0;
+            for(uint c=0;c<7;++c) if(value >= (pq3_book[c]+pq3_book[c+1])*0.5) ++index;
+            bits |= index << (3*lane);
+        }
+        for(uint b=0;b<3;++b) data_q[dst_idx].qs[3*group+b]=uint8_t((bits>>(8*b))&255);
+    }
+}
 #endif
 
