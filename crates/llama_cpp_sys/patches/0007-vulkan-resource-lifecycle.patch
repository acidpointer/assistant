+// Initialization, device publication and explicit cleanup share one lock. Recursion is needed by initialization helpers.
+std::recursive_mutex vk_instance_mutex;
 static bool vk_instance_initialized = false;
 
 vk_instance_t vk_instance;
+
+bool ggml_backend_vk_cleanup() {
+    try {
+        std::lock_guard<std::recursive_mutex> guard(vk_instance_mutex);
+        std::unique_lock<std::shared_mutex> host_guard(vk_instance.host_allocations_mutex);
+        if (!vk_instance.host_allocations.empty()) {
+            return false;
+        }
+
+        // Do not mutate the cache until every device is known to be unused. Staging is its only internal strong reference.
+        for (const auto & device : vk_instance.devices) {
+            if (!device) {
+                continue;
+            }
+            const long internal_refs = 1 + (device->sync_staging ? 1 : 0);
+            if (device.use_count() != internal_refs ||
+                (device->sync_staging && device->sync_staging.use_count() != 1)) {
+                return false;
+            }
+        }
+        for (const auto & device : vk_instance.devices) {
+            if (device) {
+                const VkResult result = VULKAN_HPP_DEFAULT_DISPATCHER.vkDeviceWaitIdle(device->device);
+                if (result != VK_SUCCESS && result != VK_ERROR_DEVICE_LOST) {
+                    GGML_LOG_ERROR("ggml_vulkan: device synchronization failed during cleanup (%d)\n", int(result));
+                    return false;
+                }
+            }
+        }
+        for (auto & device : vk_instance.devices) {
+            if (device) {
+                ggml_vk_destroy_buffer(device->sync_staging);
+                device.reset();
+            }
+        }
+        return true;
+    } catch (const std::exception & e) {
+        GGML_LOG_ERROR("ggml_vulkan: cleanup failed: %s\n", e.what());
+    } catch (...) {
+        GGML_LOG_ERROR("ggml_vulkan: cleanup failed with an unknown exception\n");
+    }
+    return false;
+}
+
+static void ggml_vk_cleanup_at_exit() noexcept {
+    // Register after driver initialization: an executable's static destructor can run after the driver's finalizers.
+    // https://github.com/ggml-org/llama.cpp/issues/10528
+    try {
+        if (!ggml_backend_vk_cleanup()) {
+            GGML_LOG_WARN("ggml_vulkan: skipping process-exit cleanup because resources remain live or cleanup failed\n");
+            return;
+        }
+        std::lock_guard<std::recursive_mutex> guard(vk_instance_mutex);
+        if (vk_instance.instance) {
+            vk_instance.instance.destroy();
+            vk_instance.instance = nullptr;
+        }
+    } catch (...) {
+        fprintf(stderr, "ggml_vulkan: process-exit cleanup failed\n");
+    }
+}
 
