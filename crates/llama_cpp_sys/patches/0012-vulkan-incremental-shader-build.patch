Subject: Preserve unchanged shader outputs and bound nested compiler jobs
Base: llama.cpp a34de8618b25dfc32ee43749db47d767a9f0a25d (b12015)

Why: each shader rule can otherwise start sixteen glslc jobs while Ninja runs
many rules concurrently. Bound the per-rule jobs and concurrent rules, preserve
identical generated C++ timestamps, and pass compiler launchers to the independent
host-generator sub-build. Shader variants and numerical compilation flags stay
unchanged. All changes apply only to the build-directory copy.

diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp b/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
--- a/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
@@ -340,7 +340,7 @@
 compile_count_guard acquire_compile_slot() {
     // wait until fewer than N compiles are in progress.
     // 16 is an arbitrary limit, the goal is to avoid "failed to create pipe" errors.
-    uint32_t N = std::max(1u, std::min(16u, std::thread::hardware_concurrency()));
+    uint32_t N = std::max(1u, std::min(uint32_t(GGML_VULKAN_SHADER_JOBS), std::thread::hardware_concurrency()));
     std::unique_lock<std::mutex> guard(compile_count_mutex);
     compile_count_cond.wait(guard, [N] { return compile_count < N; });
     compile_count++;
@@ -1390,7 +1390,7 @@
         write_file_if_changed(target_hpp, hdr.str());
     }
     if (target_cpp != "") {
-        write_binary_file(target_cpp, src.str());
+        write_file_if_changed(target_cpp, src.str());
     }
 }
 
