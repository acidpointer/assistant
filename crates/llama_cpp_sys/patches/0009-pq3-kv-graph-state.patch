+        std::array<uint8_t,128> bytes;bytes.fill(0xa5);
+        require(llama_state_get_size(ctx.get())==0,"state size rejected");
+        require(llama_state_seq_get_size(ctx.get(),0)==0,"sequence size rejected");
+        require(llama_state_seq_get_size_ext(ctx.get(),0,LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY)==0,"partial size rejected");
+        require(llama_state_get_data(ctx.get(),bytes.data(),bytes.size())==0,"state export rejected");
+        require(llama_state_set_data(ctx.get(),bytes.data(),bytes.size())==0,"state import rejected");
+        require(llama_state_seq_get_data_ext(ctx.get(),bytes.data(),bytes.size(),0,LLAMA_STATE_SEQ_FLAGS_ON_DEVICE)==0,"device state rejected before buffer access");
+        require(llama_state_seq_set_data_ext(ctx.get(),bytes.data(),bytes.size(),0,LLAMA_STATE_SEQ_FLAGS_ON_DEVICE)==0,"device restore rejected before parsing");
+        for(auto b:bytes) require(b==0xa5,"state buffers unchanged");
+        const auto file=std::filesystem::temp_directory_path()/std::filesystem::path("pq3-state-"+std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+        {std::ofstream out(file);out<<"unchanged";require(bool(out),"state sentinel file");}
+        size_t count=123;llama_token token=456;
+        require(!llama_state_save_file(ctx.get(),file.string().c_str(),tokens.data(),tokens.size()),"file save rejected");
+        require(!llama_state_load_file(ctx.get(),file.string().c_str(),&token,1,&count),"file load rejected");
+        require(llama_state_seq_save_file(ctx.get(),file.string().c_str(),0,tokens.data(),tokens.size())==0,"sequence file save rejected");
+        require(llama_state_seq_load_file(ctx.get(),file.string().c_str(),0,&token,1,&count)==0,"sequence file load rejected");
+        {std::ifstream in(file);std::string contents;in>>contents;std::filesystem::remove(file);require(contents=="unchanged","state file unchanged");}
+        require(count==123&&token==456,"file failure leaves token outputs unchanged");
+        llama_memory_seq_add(memory,0,0,-1,2);llama_memory_seq_div(memory,0,0,-1,2);
+        require(llama_memory_seq_pos_max(memory,0)==pos,"shift rejection leaves all memory unchanged");
+        llama_memory_clear(memory,true);
+        require(llama_decode(ctx.get(),batch)==0,"PQ3 reset/replay");
+    }
+}
+int main(int argc,char ** argv) {
+    llama_backend_init();
+    int result=0;
+    try {
+        require(llama_pq3_graph_abi_v1()==1,"graph ABI");
+        transform_test(); for(bool half:{false,true}) for(bool wide:{false,true}) writes_test(half,wide);attention_test(false);attention_test(true);
+        if(argc>1) model_test(argv[1]);
+        std::puts("PQ3 CPU graphs passed");
+    } catch(const std::exception & e) {std::fprintf(stderr,"PQ3 graph test failed: %s\n",e.what());result=1;}
+    llama_backend_free();return result;
+}
