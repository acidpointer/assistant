+// PQ3 graph transform v1: fixed bit convention, no PRNG or environment state.
+static inline float llama_pq3_sign(uint32_t i) {
+    static constexpr uint32_t words[4] = { 0x40f54e8c, 0x6587b7b0, 0xc31220ea, 0x32f6449b };
+    return ((words[(i % 128)/32] >> (i % 32)) & 1) ? -1.0f : 1.0f;
+}
+
+// Apply D without changing coordinate/head order. H remains the existing hinted
+// operation; forward is H(D*x), inverse is D(H*x). Never hint HD as plain H.
+static inline ggml_tensor * llama_pq3_apply_signs(
+        ggml_context * ctx, ggml_tensor * cur, ggml_tensor * signs) {
+    if (!signs) { return cur; }
+    ggml_tensor * shaped = ggml_is_contiguous(cur)
+        ? ggml_reshape_2d(ctx, cur, 128, ggml_nelements(cur)/128)
+        : ggml_cont_2d(ctx, cur, 128, ggml_nelements(cur)/128);
+    ggml_tensor * res = ggml_mul(ctx, shaped, signs);
+    return ggml_reshape_4d(ctx, res, cur->ne[0], cur->ne[1], cur->ne[2], cur->ne[3]);
+}
+
 static inline ggml_tensor * llama_mul_mat_hadamard(
         ggml_context * ctx,
         ggml_tensor * cur,
