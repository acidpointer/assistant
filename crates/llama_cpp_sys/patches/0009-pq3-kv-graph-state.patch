+static int parity(unsigned n) { int p=0; for (;n;n>>=1) p^=(n&1); return p; }
+static void transform_test() {
+    arena a;
+    auto * h=ggml_new_tensor_2d(a.p,GGML_TYPE_F32,128,128);
+    auto * signs=ggml_new_tensor_1d(a.p,GGML_TYPE_F32,128);
+    auto * basis=ggml_new_tensor_2d(a.p,GGML_TYPE_F32,128,128);
+    auto * hp=(float *) h->data; auto * bp=(float *) basis->data;
+    std::fill(bp,bp+128*128,0.0f);
+    const uint32_t masks[4]={0x40f54e8c,0x6587b7b0,0xc31220ea,0x32f6449b};
+    for(unsigned j=0;j<128;++j) {
+        bp[j*128+j]=1.0f;
+        ((float *) signs->data)[j]=((masks[j/32]>>(j%32))&1) ? -1.0f:1.0f;
+        for(unsigned i=0;i<128;++i) hp[j*128+i]=(parity(i&j)?-1.0f:1.0f)/std::sqrt(128.0f);
+    }
+    auto * forward=llama_mul_mat_hadamard(a.p,llama_pq3_apply_signs(a.p,basis,signs),h);
+    auto * inverse=llama_pq3_apply_signs(a.p,llama_mul_mat_hadamard(a.p,forward,h),signs);
+    compute(a,inverse);
+    for(unsigned j=0;j<128;++j) for(unsigned i=0;i<128;++i) {
+        const float expected=(parity(i&j)?-1.0f:1.0f)/std::sqrt(128.0f)*((float *) signs->data)[j];
+        require(std::fabs(((float *)forward->data)[j*128+i]-expected)<2e-6f,"basis sign/order/normalization");
+        require(std::fabs(((float *)inverse->data)[j*128+i]-bp[j*128+i])<2e-5f,"T inverse T");
+    }
+    require(llama_pq3_sign(2)==-1.0f && llama_pq3_sign(0)==1.0f,"sign bit convention");
