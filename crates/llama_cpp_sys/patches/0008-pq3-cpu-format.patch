--- /dev/null
+++ b/tests/test-pq3-reference.cpp
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: MIT
+// Model-free PQ3 format/CPU oracle. No backend, rotation or cache support claim.
+#include "ggml.h"
+#include "ggml-cpu.h"
+#include "ggml-quants.h"
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdio>
+#include <cstring>
+#include <stdexcept>
+
+static void require(bool condition, const char * message) {
+    if (!condition) throw std::runtime_error(message);
+}
+static void check_reference() {
+    require(ggml_pq3_reference_abi_v1() == 1, "ABI version");
+    require(GGML_TYPE_F8_E4M3 == 43 && GGML_TYPE_PQ3_0 == 44, "type IDs");
+    require(ggml_blck_size(GGML_TYPE_PQ3_0) == 128, "block width");
+    require(ggml_type_size(GGML_TYPE_PQ3_0) == 50 && offsetof(block_pq3_0, d) == 48, "layout");
+    require(ggml_row_size(GGML_TYPE_PQ3_0, 256) == 100, "row size");
+    std::array<float, 256> input{};
+    std::array<block_pq3_0, 2> blocks{};
+    std::array<float, 256> decoded{};
+    quantize_row_pq3_0_ref(input.data(), blocks.data(), input.size());
+    for (const auto & b : blocks) {
+        require(b.d == 0, "zero norm");
+        for (auto byte : b.qs) require(byte == 0, "canonical zero");
+    }
+    // Golden positive constant: normalized coordinates 1/sqrt(128), index 5.
+    input.fill(1.0f);
+    quantize_row_pq3_0_ref(input.data(), blocks.data(), input.size());
+    for (const auto & b : blocks) {
+        for (int g = 0; g < 16; ++g) {
+            require(b.qs[g*3] == 0x6d && b.qs[g*3+1] == 0xdb && b.qs[g*3+2] == 0xb6, "golden 3-bit packing");
+        }
+        require(std::fabs(ggml_fp16_to_fp32(b.d) - std::sqrt(128.0f)) < 0.004f, "stored L2 norm");
+    }
+    dequantize_row_pq3_0(blocks.data(), decoded.data(), decoded.size());
+    require(std::fabs(decoded[0] - 0.06658560804735174f * ggml_fp16_to_fp32(blocks[0].d)) < 1e-7f, "codebook reconstruction");
+    // Arbitrary packed indices exercise every bit boundary independently of encoder.
+    block_pq3_0 ramp{}; ramp.d = ggml_fp32_to_fp16(1.0f);
+    for (int g = 0; g < 16; ++g) { ramp.qs[g*3]=0x88; ramp.qs[g*3+1]=0xc6; ramp.qs[g*3+2]=0xfa; }
+    dequantize_row_pq3_0(&ramp, decoded.data(), 128);
+    const float codebook[8]={-0.18839718597003241f,-0.11813976699668613f,-0.06658560804735174f,-0.02160431064212660f,0.02160431064212660f,0.06658560804735174f,0.11813976699668613f,0.18839718597003241f};
+    for (int i=0;i<128;++i) require(decoded[i] == codebook[i%8], "independent index unpacking");
+    // Midpoint zero must choose the upper centroid. Use one nonzero coordinate
+    // to keep the norm nonzero without affecting the remaining exact zero ties.
+    input.fill(0.0f); input[127]=1.0f; input[255]=-1.0f;
+    quantize_row_pq3_0_ref(input.data(), blocks.data(), input.size());
+    require((blocks[0].qs[0]&7)==4 && (blocks[1].qs[0]&7)==4, "midpoint tie");
+    for (size_t i=0;i<input.size();++i) input[i]=std::sin(float(i)*0.31f)*0.3f;
+    quantize_row_pq3_0_ref(input.data(), blocks.data(), input.size());
+    std::array<block_pq3_0,2> repeated{};
+    quantize_row_pq3_0_ref(input.data(), repeated.data(), input.size());
+    require(std::memcmp(blocks.data(),repeated.data(),sizeof(blocks))==0,"repeatability");
+    dequantize_row_pq3_0(blocks.data(),decoded.data(),decoded.size());
+    std::array<block_q8_0,8> q8{}; std::array<float,256> query{};
+    quantize_row_q8_0_ref(input.data(),q8.data(),input.size());
+    dequantize_row_q8_0(q8.data(),query.data(),query.size());
+    const auto * traits=ggml_get_type_traits_cpu(GGML_TYPE_PQ3_0);
+    require(traits->from_float && traits->vec_dot && traits->vec_dot_type==GGML_TYPE_Q8_0 && traits->nrows==1,"CPU traits");
+    float actual=0.0f; traits->vec_dot(256,&actual,0,blocks.data(),0,q8.data(),0,1);
+    double expected=0.0, mse=0.0, energy=0.0;
+    for (size_t i=0;i<input.size();++i) { expected+=double(decoded[i])*query[i]; mse+=std::pow(double(decoded[i])-input[i],2); energy+=double(input[i])*input[i]; }
+    require(std::fabs(actual-expected)<1e-5*std::fmax(1.0,std::fabs(expected)),"dot against independently reconstructed Q8 query");
+    require(mse/energy<0.1,"reference reconstruction stress bound");
+    // Single-query attention: native CPU scores versus independently decoded
+    // F64 dots, followed by separately computed normalization/value sums.
+    std::array<float,256> values{};
+    for (size_t i=0;i<values.size();++i) values[i]=std::cos(float(i)*0.17f)*0.2f;
+    std::array<block_pq3_0,2> encoded_values{};
+    quantize_row_pq3_0_ref(values.data(),encoded_values.data(),values.size());
+    dequantize_row_pq3_0(encoded_values.data(),values.data(),values.size());
+    double reference_scores[2]{};float scores[2]{};
+    for (int row=0;row<2;++row) {
+        traits->vec_dot(128,&scores[row],0,&blocks[row],0,q8.data(),0,1);
+        scores[row]/=std::sqrt(128.0f);
+        for (int i=0;i<128;++i) reference_scores[row]+=double(decoded[row*128+i])*query[i]/std::sqrt(128.0);
+    }
+    const double reference_weight=1.0/(1.0+std::exp(reference_scores[1]-reference_scores[0]));
+    const float weight=1.0f/(1.0f+std::exp(scores[1]-scores[0]));
+    for (int i=0;i<128;++i) {
+        const double expected_value=reference_weight*values[i]+(1.0-reference_weight)*values[128+i];
+        const float actual_value=weight*values[i]+(1.0f-weight)*values[128+i];
+        require(std::fabs(actual_value-expected_value)<1e-6,"reference attention value aggregation");
+    }
+    std::array<block_pq3_0,2> chunk{};
+    require(ggml_quantize_chunk(GGML_TYPE_PQ3_0,input.data(),chunk.data(),0,2,128,nullptr)==100,"generic row quantization");
+    require(std::memcmp(chunk.data(),blocks.data(),sizeof(blocks))==0,"generic/reference packing agreement");
+    require(ggml_validate_row_data(GGML_TYPE_PQ3_0,chunk.data(),sizeof(chunk)),"valid row bytes");
+    chunk[0].d=0x7c00;
+    require(!ggml_validate_row_data(GGML_TYPE_PQ3_0,chunk.data(),sizeof(chunk)),"invalid row bytes");
+    // Underflow is deterministic and does not read partially written blocks.
+    input.fill(1e-30f); quantize_row_pq3_0_ref(input.data(),blocks.data(),input.size());
+    for (const auto & block:blocks) { require(block.d==0,"tiny norm"); for(auto v:block.qs) require(v==0,"tiny canonical payload"); }
+}
+int main() {
+    ggml_context * context=ggml_init({4096,nullptr,true});
+    if (!context) return 1;
+    try { check_reference(); }
+    catch(const std::exception & e) { std::fprintf(stderr,"PQ3 reference failed: %s\n",e.what()); ggml_free(context); return 1; }
+    ggml_free(context); std::puts("PQ3 CPU reference passed"); return 0;
+}
