+// Deliberately scalar reference: decode PQ3 and Q8 query blocks explicitly.
+// This is not a fused attention kernel or a model-weight quantization format.
+uint32_t ggml_pq3_cpu_reference_abi_v1(void) { return 1; }
+
+void quantize_row_pq3_0(const float * GGML_RESTRICT x, void * GGML_RESTRICT y, int64_t k) {
+    quantize_row_pq3_0_ref(x, (block_pq3_0 *) y, k);
+}
+
+void ggml_vec_dot_pq3_0_q8_0(int n, float * GGML_RESTRICT s, size_t bs,
+        const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+    assert(n >= 0 && n % QK_PQ3_0 == 0 && nrc == 1);
+    UNUSED(bs); UNUSED(bx); UNUSED(by); UNUSED(nrc);
+    const block_pq3_0 * x = (const block_pq3_0 *) vx;
+    const block_q8_0 * y = (const block_q8_0 *) vy;
+    float sum = 0.0f;
+    for (int i = 0; i < n / QK_PQ3_0; ++i) {
+        float key[QK_PQ3_0];
+        dequantize_row_pq3_0(x + i, key, QK_PQ3_0);
+        for (int j = 0; j < QK_PQ3_0 / QK8_0; ++j) {
+            float query[QK8_0];
+            dequantize_row_q8_0(y + i * (QK_PQ3_0 / QK8_0) + j, query, QK8_0);
+            float partial = 0.0f;
+            for (int lane = 0; lane < QK8_0; ++lane) partial += key[j * QK8_0 + lane] * query[lane];
+            sum += partial;
+        }
+    }
+    *s = sum;
+}
 
