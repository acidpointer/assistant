+
+// PQ3 CPU reference, adapted from QVAC PR 115 at
+// 362003a25376555e5c01939ed82710bbb2c3bcf8, ggml-quants.c (MIT).
+// Rotation belongs to a future graph patch. No environment-dependent scales.
+static const float pq3_codebook_128[8] = {
+    -0.18839718597003241f, -0.11813976699668613f,
+    -0.06658560804735174f, -0.02160431064212660f,
+     0.02160431064212660f,  0.06658560804735174f,
+     0.11813976699668613f,  0.18839718597003241f,
+};
+
+uint32_t ggml_pq3_reference_abi_v1(void) { return 1; }
+
+size_t quantize_pq3_0(const float * GGML_RESTRICT src, void * GGML_RESTRICT dst,
+        int64_t nrows, int64_t n_per_row, const float * weights) {
+    GGML_UNUSED(weights);
+    assert(nrows >= 0 && n_per_row >= 0 && n_per_row % QK_PQ3_0 == 0);
+    quantize_row_pq3_0_ref(src, (block_pq3_0 *) dst, nrows * n_per_row);
+    return (size_t) nrows * ggml_row_size(GGML_TYPE_PQ3_0, n_per_row);
+}
+
+void quantize_row_pq3_0_ref(const float * GGML_RESTRICT x, block_pq3_0 * GGML_RESTRICT y, int64_t k) {
+    assert(k >= 0 && k % QK_PQ3_0 == 0);
+    float boundaries[7];
+    for (int j = 0; j < 7; ++j) {
+        boundaries[j] = (pq3_codebook_128[j] + pq3_codebook_128[j + 1]) * 0.5f;
+    }
+    for (int64_t i = 0; i < k / QK_PQ3_0; ++i) {
+        const float * src = x + i * QK_PQ3_0;
+        float sum = 0.0f;
+        for (int j = 0; j < QK_PQ3_0; ++j) sum += src[j] * src[j];
+        const float norm = sqrtf(sum);
+        y[i].d = GGML_FP32_TO_FP16(norm);
+        // Canonical zero also covers subnormals whose norm underflows FP16.
+        if (y[i].d == 0) { memset(y[i].qs, 0, sizeof(y[i].qs)); continue; }
+        const float inv_norm = 1.0f / norm;
+        for (int group = 0; group < QK_PQ3_0 / 8; ++group) {
+            uint32_t bits = 0;
+            for (int lane = 0; lane < 8; ++lane) {
+                const float value = src[group * 8 + lane] * inv_norm;
+                // Midpoint ties choose the higher centroid, including zero.
+                uint32_t index = 0;
+                while (index < 7 && !(value < boundaries[index])) ++index;
+                bits |= index << (lane * 3);
+            }
+            y[i].qs[group * 3 + 0] = (uint8_t) bits;
+            y[i].qs[group * 3 + 1] = (uint8_t) (bits >> 8);
+            y[i].qs[group * 3 + 2] = (uint8_t) (bits >> 16);
+        }
+    }
+}
+
+void dequantize_row_pq3_0(const block_pq3_0 * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    assert(k >= 0 && k % QK_PQ3_0 == 0);
+    for (int64_t i = 0; i < k / QK_PQ3_0; ++i) {
+        const float norm = GGML_FP16_TO_FP32(x[i].d);
+        if (norm == 0.0f) { memset(y + i * QK_PQ3_0, 0, QK_PQ3_0 * sizeof(float)); continue; }
+        for (int group = 0; group < QK_PQ3_0 / 8; ++group) {
+            const uint32_t bits = (uint32_t) x[i].qs[group * 3 + 0]
+                | ((uint32_t) x[i].qs[group * 3 + 1] << 8)
+                | ((uint32_t) x[i].qs[group * 3 + 2] << 16);
+            for (int lane = 0; lane < 8; ++lane) {
+                y[i * QK_PQ3_0 + group * 8 + lane] = pq3_codebook_128[(bits >> (lane * 3)) & 7] * norm;
+            }
+        }
+    }
 }
 
