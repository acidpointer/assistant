+// Experimental PQ3 reference. Adapted from tetherto/qvac-fabric-llm.cpp
+// 362003a25376555e5c01939ed82710bbb2c3bcf8 (MIT; see root LICENSE).
+// Indices precede the FP16 L2 norm, matching that donor's 128-value layout.
+#define QK_PQ3_0 128
+#define PQ3_0_INDEX_BYTES 48
