diff --git a/ggml/src/ggml-threading.cpp b/ggml/src/ggml-threading.cpp
--- a/ggml/src/ggml-threading.cpp
+++ b/ggml/src/ggml-threading.cpp
@@ -1,4 +1,5 @@
 #include "ggml-threading.h"
+#include "ggml-impl.h"
 #include <mutex>
 
 std::mutex ggml_critical_section_mutex;
@@ -10,3 +11,43 @@
 void ggml_critical_section_end(void) {
     ggml_critical_section_mutex.unlock();
 }
+
+// Keep this lock separate from the context initialization lock: ggml can log
+// while initializing. Never invoke a callback while holding either logger lock.
+namespace {
+struct logger_state {
+    ggml_log_callback callback;
+    void * user_data;
+};
+std::mutex logger_mutex;
+logger_state global_logger = {ggml_log_callback_default, nullptr};
+thread_local logger_state thread_logger = {nullptr, nullptr};
+}
+
+void ggml_log_get(ggml_log_callback * callback, void ** user_data) {
+    const std::lock_guard<std::mutex> lock(logger_mutex);
+    *callback = global_logger.callback;
+    *user_data = global_logger.user_data;
+}
+
+void ggml_log_set(ggml_log_callback callback, void * user_data) {
+    const std::lock_guard<std::mutex> lock(logger_mutex);
+    global_logger = {callback ? callback : ggml_log_callback_default, user_data};
+}
+
+void ggml_log_get_thread(ggml_log_callback * callback, void ** user_data) {
+    *callback = thread_logger.callback;
+    *user_data = thread_logger.user_data;
+}
+
+void ggml_log_set_thread(ggml_log_callback callback, void * user_data) {
+    thread_logger = {callback, user_data};
+}
+
+void ggml_log_dispatch(enum ggml_log_level level, const char * text) {
+    logger_state logger = thread_logger;
+    if (!logger.callback) {
+        ggml_log_get(&logger.callback, &logger.user_data);
+    }
+    logger.callback(level, text, logger.user_data);
+}
