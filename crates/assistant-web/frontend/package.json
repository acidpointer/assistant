{
  "name": "assistant-webui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/seal-build.mjs",
    "check": "tsc --noEmit && oxlint --type-aware --deny-warnings && steiger src && oxfmt --check",
    "format": "oxfmt",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "decode-named-character-reference": "1.3.0",
    "marked": "18.1.3",
    "parse-entities": "4.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "refractor": "5.0.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "steiger": "0.9.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
